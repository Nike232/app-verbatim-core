{
  "name": "app-verbatim",
  "version": "0.5.2",
  "description": "Catch App Store and Google Play review regressions in CI, with source evidence.",
  "keywords": [
    "app-store",
    "google-play",
    "reviews",
    "product-research",
    "competitive-analysis",
    "release-monitoring",
    "github-actions",
    "mcp",
    "quality-gate",
    "cli"
  ],
  "homepage": "https://github.com/Nike232/app-verbatim-core#readme",
  "bugs": {
    "url": "https://github.com/Nike232/app-verbatim-core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nike232/app-verbatim-core.git"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Tomfng",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./connectors": {
      "types": "./src/index.d.ts",
      "import": "./src/connectors/index.js"
    },
    "./exporters": {
      "types": "./src/index.d.ts",
      "import": "./src/exporters.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "app-verbatim": "./src/cli.js"
  },
  "files": [
    "src/",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test test/*.test.js",
    "test:live": "node --test test/connectors-live.test.js",
    "build:action": "esbuild src/action.js --bundle --platform=node --target=node24 --format=cjs --outfile=dist/action.cjs --legal-comments=external",
    "check:syntax": "node --check src/cli.js && node --check src/index.js && node --check src/version.js && node --check src/regression.js && node --check src/discovery.js && node --check src/mcp.js && node --check src/action.js",
    "check:types": "tsc -p test/types/tsconfig.json --noEmit",
    "check:demo": "node scripts/demo-smoke.mjs",
    "check:eval": "node scripts/evaluate.mjs",
    "check:mcp": "node scripts/mcp-smoke.mjs",
    "check:action": "node scripts/verify-action-bundle.mjs && node scripts/action-smoke.mjs",
    "check:pack": "npm pack --dry-run && node scripts/package-smoke.mjs",
    "check": "npm run check:syntax && npm run check:types && npm test && npm run check:eval && npm run check:demo && npm run check:mcp && npm run check:action && npm run check:pack"
  },
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mradex77/google-play-scraper": "^1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
